# ==========================================
# REQUIRED ENVIRONMENT VARIABLES FOR VERCEL
# ==========================================

# Supabase Public URL (Get from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Public Anon Key (Get from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Service Role Secret Key (Get from Supabase Dashboard -> Project Settings -> API)
# NEVER expose this key on the client side!
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Secret key for JWT signing and session validation
JWT_SECRET="your-secure-jwt-secret-key"

# Groq LLM API Key (Get from https://console.groq.com)
# Used for AI Task Breakdown, Smart Assignee Recommendation, and Description Generation
GROQ_API_KEY="gsk_your_groq_api_key"

# ==========================================
# OPTIONAL ENVIRONMENT VARIABLES
# ==========================================

# Resend Email API Key (Get from https://resend.com)
# Used for sending email invitations to project members
RESEND_API_KEY="re_your_resend_api_key"

# Google Gemini LLM API Key (Get from https://aistudio.google.com)
# Used as alternative AI provider if Groq is unavailable
GEMINI_API_KEY="your-gemini-api-key"

# GitHub OAuth App Credentials (For GitHub Skill Matcher)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Prisma Database URL (If connecting Prisma directly to PostgreSQL/Supabase DB)
DATABASE_URL="postgresql://user:password@host:5432/dbname"
